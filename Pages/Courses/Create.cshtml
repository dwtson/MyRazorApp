@page
@model MyRazorApp.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "Add Course";
}

<section class="page-banner">
    <div class="container">
        <h1>Add a New Course</h1>
        <p>Create a new course record in the SQLite database.</p>
    </div>
</section>

<section class="section-block">
    <div class="container form-container">
        <form method="post" class="kasper-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="form-group">
                <label asp-for="Course.CourseTitle"></label>
                <input asp-for="Course.CourseTitle" required />
                <span asp-validation-for="Course.CourseTitle" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Course.CourseAwardName"></label>
                <input asp-for="Course.CourseAwardName" placeholder="e.g. BSc (Honours) or MSc" required />
                <span asp-validation-for="Course.CourseAwardName" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Course.CourseSubject"></label>
                <select asp-for="Course.CourseSubject">
                    <option value="Computing">Computing</option>
                    <option value="Art and design">Art and design</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Course.CourseType"></label>
                <select asp-for="Course.CourseType">
                    <option value="Undergraduate">Undergraduate</option>
                    <option value="Postgraduate">Postgraduate</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Course.CourseSummary"></label>
                <textarea asp-for="Course.CourseSummary" rows="4" required></textarea>
                <span asp-validation-for="Course.CourseSummary" class="field-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Course.UcasCode"></label>
                    <input asp-for="Course.UcasCode" placeholder="e.g. G504" />
                </div>

                <div class="form-group">
                    <label asp-for="Course.UcasPoints"></label>
                    <input asp-for="Course.UcasPoints" type="number" placeholder="e.g. 112" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Course.YearOfEntry"></label>
                    <input asp-for="Course.YearOfEntry" required />
                </div>

                <div class="form-group">
                    <label asp-for="Course.ModeOfAttendance"></label>
                    <input asp-for="Course.ModeOfAttendance" required />
                </div>

                <div class="form-group">
                    <label asp-for="Course.StudyLength"></label>
                    <input asp-for="Course.StudyLength" required />
                </div>
            </div>

            <div class="form-group checkbox-group">
                <label>
                    <input asp-for="Course.HasFoundationYear" />
                    Includes Foundation Year
                </label>
            </div>

            <div class="form-group checkbox-group">
                <label>
                    <input asp-for="Course.NoLongerRecruiting" />
                    No Longer Recruiting
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Course</button>
                <a asp-page="Index" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</section>
